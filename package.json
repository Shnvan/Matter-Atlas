{
  "name": "inside-the-uno",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "prebuild": "node scripts/prepare-docs.mjs",
    "build": "next build",
    "preview": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "validate:foundation": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-foundation.ps1",
    "predev": "node scripts/prepare-docs.mjs",
    "format": "prettier --write src tests scripts/*.mjs *.ts *.mjs"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.2.0",
    "@radix-ui/react-slot": "1.4.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "geist": "1.7.2",
    "lucide-react": "1.52.0",
    "motion": "14.0.0",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-aria-components": "1.21.1",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "prettier": "3.6.2",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  },
  "type": "module"
}
